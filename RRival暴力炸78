-- 3. 核心渲染、重生掛載與物理邏輯
-- ==========================================
local function onCharacterAdded(character)
    local hum = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")
    
    if Config.FlyEnabled then
        hum.PlatformStand = true
        task.wait(0.1)
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = root
    end
    
    if Config.FlyNoclip or Config.TPEnabled then
        for _, part in pairs(character:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end
LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

-- 【核心防消失】每次渲染都檢查並強制重建 UI
local function forceCreateESP(targetPlayer)
    local character = targetPlayer.Character
    if not character or not character:FindFirstChild("Head") then return end
    local head = character.Head
    
    -- 檢查是否已經存在，若存在且正常則不重建
    if head:FindFirstChild("Native_ESP_UI") then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Native_ESP_UI"
    billboard.Size = UDim2.new(0, 120, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head
    billboard.Parent = head

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.Size = UDim2.new(1, 0, 0.4, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Parent = billboard

    local healthText = Instance.new("TextLabel")
    healthText.Name = "HealthText"
    healthText.Size = UDim2.new(1, 0, 0.3, 0)
    healthText.Position = UDim2.new(0, 0, 0.4, 0)
    healthText.BackgroundTransparency = 1
    healthText.TextColor3 = Color3.fromRGB(0, 255, 0)
    healthText.TextStrokeTransparency = 0
    healthText.TextScaled = true
    healthText.Font = Enum.Font.SourceSansBold
    healthText.Parent = billboard

    local healthBg = Instance.new("Frame")
    healthBg.Name = "HealthBg"
    healthBg.Size = UDim2.new(0, 4, 0.6, 0)
    healthBg.Position = UDim2.new(0, -10, 0.2, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    healthBg.Parent = billboard
    local UICorner4 = Instance.new("UICorner") UICorner4.CornerRadius = UDim.new(0, 2) UICorner4.Parent = healthBg

    local healthBar = Instance.new("Frame")
    healthBar.Name = "HealthBar"
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.Parent = healthBg
    local UICorner5 = Instance.new("UICorner") UICorner5.CornerRadius = UDim.new(0, 2) UICorner5.Parent = healthBar

    ESP_Objects[targetPlayer] = {
        billboard = billboard, nameLabel = nameLabel,
        healthText = healthText, healthBar = healthBar, healthBg = healthBg
    }
end

local lastUpdate = 0

RunService.RenderStepped:Connect(function()
    if FlyControl.Visible ~= Config.FlyEnabled then FlyControl.Visible = Config.FlyEnabled end

    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local myHum = char and char:FindFirstChildOfClass("Humanoid")

    -- 飛天物理更新
    if isFlying and bodyVelocity and myRoot and myHum then
        if Config.FlyNoclip then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        local moveDir = Vector3.new(0, 0, 0)
        local playerModule = LocalPlayer:FindFirstChild("PlayerScripts"):FindFirstChild("PlayerModule")
        if playerModule then
            local controls = require(playerModule):GetControls()
            local moveVector = controls:GetMoveVector()
            if moveVector.Magnitude > 0 then
                moveDir = (Camera.CFrame.LookVector * -moveVector.Z) + (Camera.CFrame.RightVector * moveVector.X)
            end
        end
        if flyUp then moveDir += Vector3.new(0, 1, 0) end
        if flyDown then moveDir -= Vector3.new(0, 1, 0) end
        
        if moveDir.Magnitude > 0 then
            bodyVelocity.Velocity = moveDir.Unit * flySpeed
        else
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
    end

    -- 瞬移追擊物理
    if Config.TPEnabled and myRoot and myHum then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        local closestPlayer = nil
        local closestDist = MaxDistance

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not isTeammate(player) and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPlayer = player
                    end
                end
            end
        end

        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = closestPlayer.Character.HumanoidRootPart
            local enemyLook = enemyRoot.CFrame.LookVector
            
            -- 根據設定的距離計算位置
            local targetPos
            if Config.TP_Distance == 0 then
                targetPos = enemyRoot.Position -- 0m 完全重疊
            elseif Config.TP_Distance == 5 then
                targetPos = enemyRoot.Position + Vector3.new(0, 3.5, 0) -- 5m 飛到頭上 (考量頭部高度)
            else
                targetPos = enemyRoot.Position + (enemyLook * Config.TP_Distance) -- 預設 2m (面前)
            end
            
            myRoot.CFrame = CFrame.new(targetPos, enemyRoot.Position) 
        end
    end

    -- 透視渲染
    if not Config.Enabled then
        for plr, _ in pairs(ESP_Objects) do 
            if ESP_Objects[plr].billboard then ESP_Objects[plr].billboard:Destroy() end
        end
        ESP_Objects = {}
        return
    end

    local tick = tick()
    if tick - lastUpdate < 0.05 then return end
    lastUpdate = tick

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isTeammate(player) and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and root and humanoid and humanoid.Health > 0 and myRoot then
                local dist = (myRoot.Position - root.Position).Magnitude
                
                -- 超出距離就強制刪除
                if dist > MaxDistance then
                    if ESP_Objects[player] then
                        ESP_Objects[player].billboard:Destroy()
                        ESP_Objects[player] = nil
                    end
                    continue
                end

                -- 檢查並強制建立
                forceCreateESP(player)
                
                local ui = ESP_Objects[player]
                -- 再次確認 UI 是否存活
                if ui and ui.billboard and ui.billboard.Parent then
                    ui.nameLabel.Visible = Config.Name or Config.Distance
                    if Config.Name and Config.Distance then
                        ui.nameLabel.Text = player.Name .. " [" .. math.floor(dist) .. "m]"
                    elseif Config.Name then
                        ui.nameLabel.Text = player.Name
                    elseif Config.Distance then
                        ui.nameLabel.Text = "[" .. math.floor(dist) .. "m]"
                    end
                    
                    ui.healthText.Visible = Config.HealthText
                    ui.healthText.Text = math.floor(humanoid.Health) .. " HP"
                    
                    ui.healthBg.Visible = Config.HealthBar
                    if Config.HealthBar then
                        local ratio = humanoid.Health / humanoid.MaxHealth
                        ui.healthBar.Size = UDim2.new(1, 0, ratio, 0)
                        ui.healthBar.BackgroundColor3 = (ratio < 0.3) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                    end
                end

                -- 全身染色
                if Config.Chams then
                    if not Chams_Objects[player] then
                        local h = Instance.new("Highlight")
                        h.FillColor = Color3.fromRGB(255, 50, 50)
                        h.FillTransparency = 0.5
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Adornee = player.Character
                        h.Parent = player.Character
                        Chams_Objects[player] = {Highlight = h}
                    end
                end
            end
        end
    end
end)
