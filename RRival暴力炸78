local function createTPDistanceBtn(text, posX, posY, distValue)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.28, 0, 0, 25)
    btn.Position = UDim2.new(posX, 0, 0, posY)
    btn.BackgroundColor3 = (Config.TP_Distance == distValue) and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = (Config.TP_Distance == distValue) and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 11
    btn.Parent = Page2
    
    btn.MouseButton1Click:Connect(function()
        Config.TP_Distance = distValue
        -- 重置所有按鈕顏色
        for _, child in pairs(Page2:GetChildren()) do
            if child:IsA("TextButton") and (child.Text == "2m" or child.Text == "5m" or child.Text == "0m") then
                child.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                child.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
        -- 高亮當前選中
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    end)
end

